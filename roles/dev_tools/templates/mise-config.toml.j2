# {{ ansible_managed }}
# 開発ユーザーのグローバル mise 設定。tool 一覧は group_vars の mise_global_tools。
[tools]
{% for tool, version in mise_global_tools.items() %}
"{{ tool }}" = "{{ version }}"
{% endfor %}

[settings]
# cd しただけで不足 tool を自動取得・ビルドしない（install は明示）。
not_found_auto_install = false
# .node-version / .python-version 等の暗黙読みを無効化し、設定ソースを
# .mise.toml / .tool-versions に限定する。
idiomatic_version_file_enable_tools = []
# experimental 機能は off に固定。
experimental = false
