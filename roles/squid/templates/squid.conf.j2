# egress proxy
#
# 3128: HTTP(S)_PROXY=http://127.0.0.1:3128 用の明示 proxy。
# 3129: iptables REDIRECT で TCP/80 を受ける HTTP intercept。
# 3130: iptables REDIRECT で TCP/443 を受ける HTTPS intercept。

# ---------------------------------------------------------------------------
# Safe ports / CONNECT 制限
# ---------------------------------------------------------------------------
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# ---------------------------------------------------------------------------
# Manager (localhost のみ)
# ---------------------------------------------------------------------------
# OUTPUT redirect されたローカル発信通信は、Squid から見ると client src が 127.0.0.1
# ではなく host 自身の LAN/WAN IP になることがある。そのため loopback に加え、
# Ansible facts で見えている host 自身のアドレスだけを /32, /128 で許可する。
acl localnet src 127.0.0.1/32
acl localnet src ::1
{% for addr in (ansible_all_ipv4_addresses | default([]) | unique | sort) %}
acl localnet src {{ addr }}/32
{% endfor %}
{% for addr in (ansible_all_ipv6_addresses | default([]) | unique | sort) %}
{% if addr != '::1' %}
acl localnet src {{ addr }}/128
{% endif %}
{% endfor %}
http_access allow localhost manager
http_access deny manager

# ---------------------------------------------------------------------------
# SslBump: SNI だけ参照、TLS は MITM しない (step2 完結型)
# allowlist は /etc/squid/allowlist.txt (regex, 1 行 1 entry)
#
# 評価フロー:
#   step1 (CONNECT 直後): peek でクライアント Hello を待つ
#   step2 (ClientHello = SNI 取得直後): allowed_sni と照合して即 splice / terminate
#   step3 には到達させない
#
# step3 まで peek を引っ張ると、step3 で splice がマッチしなかった場合に Squid の
# デフォルト action (= bump) に倒れ、TLS bump 失敗の fallback で TCP tunnel
# (= 素通し) になる事故が起きる。step2 完結型にすることでこれを防ぐ (Squid 7 で確認)。
# ---------------------------------------------------------------------------
acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl allowed_sni ssl::server_name_regex -i "/etc/squid/allowlist.txt"
acl allowed_http dstdom_regex -i "/etc/squid/allowlist.txt"
acl plain_http_ports myportname explicit_proxy http_intercept

ssl_bump peek step1
ssl_bump splice step2 allowed_sni
# step2 で SNI が allowed_sni にマッチしなかったら TLS をクライアント側で握って切る。
# クライアントには TLS error として届くので curl が exit non-zero (35 等) になる。
ssl_bump terminate step2 all

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# 平文 HTTP は SNI が無いため、destination host/domain を allowlist で直接検査する。
http_access deny plain_http_ports !CONNECT !allowed_http

http_access allow localnet
http_access allow localhost
http_access deny all

# ---------------------------------------------------------------------------
# Listen
# ---------------------------------------------------------------------------
# 明示 proxy mode (HTTP(S)_PROXY=http://127.0.0.1:3128 経由)。
# ssl-bump を付けることで HTTPS CONNECT の SNI peek が効く。
http_port 3128 name=explicit_proxy ssl-bump \
    cert=/etc/squid/dummy.pem \
    generate-host-certificates=on \
    dynamic_cert_mem_cache_size=4MB

# 透過 HTTP mode (iptables REDIRECT from TCP/80)。
http_port 3129 name=http_intercept intercept

# 透過 HTTPS mode (iptables REDIRECT from TCP/443)。
https_port 3130 name=https_intercept intercept ssl-bump \
    cert=/etc/squid/dummy.pem \
    generate-host-certificates=on \
    dynamic_cert_mem_cache_size=4MB

# SSL helper (generate-host-certificates=on で必要)。
# /var/spool/squid/ssl_db は security_file_certgen -c で初期化する。
sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/spool/squid/ssl_db -M 4MB
sslcrtd_children 5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
access_log /var/log/squid/access.log squid
cache_log /var/log/squid/cache.log
cache deny all

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
visible_hostname dev-server
forwarded_for delete
via off
