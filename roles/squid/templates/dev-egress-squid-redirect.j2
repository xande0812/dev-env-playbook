#!/usr/bin/env bash
# Redirect direct HTTP/HTTPS egress into Squid intercept ports.
set -euo pipefail

chain="DEV_SQUID_OUTPUT"
http_port="3129"
https_port="3130"

iptables_bin="/usr/sbin/iptables"
ip6tables_bin="/usr/sbin/ip6tables"

proxy_uid="$(id -u proxy)"

apply_v4() {
  "$iptables_bin" -t nat -N "$chain" 2>/dev/null || true
  "$iptables_bin" -t nat -F "$chain"

  "$iptables_bin" -t nat -A "$chain" -m owner --uid-owner "$proxy_uid" -j RETURN
  "$iptables_bin" -t nat -A "$chain" -d 127.0.0.0/8 -j RETURN
  "$iptables_bin" -t nat -A "$chain" -d 10.0.0.0/8 -j RETURN
  "$iptables_bin" -t nat -A "$chain" -d 172.16.0.0/12 -j RETURN
  "$iptables_bin" -t nat -A "$chain" -d 192.168.0.0/16 -j RETURN
  "$iptables_bin" -t nat -A "$chain" -d 169.254.0.0/16 -j RETURN
  # Tailscale の CGNAT 帯 (tailnet peer)。RFC1918 と同様に信頼境界の内側なので、
  # tailnet 宛て TCP/80,443 を Squid に横取りさせず素通しする (SSH=22 は元々対象外)。
  "$iptables_bin" -t nat -A "$chain" -d 100.64.0.0/10 -j RETURN
  "$iptables_bin" -t nat -A "$chain" -p tcp --dport 80 -j REDIRECT --to-ports "$http_port"
  "$iptables_bin" -t nat -A "$chain" -p tcp --dport 443 -j REDIRECT --to-ports "$https_port"

  "$iptables_bin" -t nat -C OUTPUT -j "$chain" 2>/dev/null || \
    "$iptables_bin" -t nat -A OUTPUT -j "$chain"
}

apply_v6() {
  "$ip6tables_bin" -t nat -N "$chain" 2>/dev/null || true
  "$ip6tables_bin" -t nat -F "$chain"

  "$ip6tables_bin" -t nat -A "$chain" -m owner --uid-owner "$proxy_uid" -j RETURN
  "$ip6tables_bin" -t nat -A "$chain" -d ::1/128 -j RETURN
  "$ip6tables_bin" -t nat -A "$chain" -d fc00::/7 -j RETURN
  "$ip6tables_bin" -t nat -A "$chain" -d fe80::/10 -j RETURN
  "$ip6tables_bin" -t nat -A "$chain" -p tcp --dport 80 -j REDIRECT --to-ports "$http_port"
  "$ip6tables_bin" -t nat -A "$chain" -p tcp --dport 443 -j REDIRECT --to-ports "$https_port"

  "$ip6tables_bin" -t nat -C OUTPUT -j "$chain" 2>/dev/null || \
    "$ip6tables_bin" -t nat -A OUTPUT -j "$chain"
}

apply_v4
if "$ip6tables_bin" -t nat -L >/dev/null 2>&1; then
  apply_v6
fi
