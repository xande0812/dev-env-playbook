#!/usr/bin/env bash
# codex 用 base: 認証は ChatGPT OAuth (~/.codex/auth.json) なので API キー env は
# 渡さない。CODEX_HOME 既定の ~/.codex (config.toml + auth.json) と、commit/PR 操作で
# 使う ~/.config/gh を bind する。~/.codex/auth.json は agent 自身の service credential で
# ~/.aws 等の汎用 secret とは別扱い (claude の ~/.claude/.credentials.json と同列)。
# 隔離核は agent-base (claude / codex 共通) に集約。
# 加えて Obsidian vault の AI 専用サブフォルダ ~/obvault/AI を rw bind する。個人ノート
# 本体 (~/obvault/ 直下) は bind しない = sandbox 内から不可視のまま。実体が無いと
# --bind-try が skip するため AGENT_MKDIR_DIRS で起動前に mkdir -p して bind を保証する。
set -euo pipefail
export AGENT_NAME="bwrap-codex-base"
export AGENT_API_KEY_ENVS=""
export AGENT_RW_BINDS=".codex .config/gh obvault/AI"
export AGENT_RO_BINDS=""
export AGENT_TOUCH_FILES=""
export AGENT_MKDIR_DIRS="obvault/AI"
exec /usr/local/lib/bwrap/agent-base "$@"
